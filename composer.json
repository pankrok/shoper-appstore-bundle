{
    "name": "pankrok/shoper-appstore-bundle",
    "type": "symfony-bundle",
    "version": "2.0.0",
    "description": "This bundle provides Shoper appstore SDK",
    "keywords": ["shoper", "appstore", "api"],
    "license": "MIT",
    "authors": [
        { 
            "name": "Jerzy Róg"
        }
    ],
    "require": {
        "php": ">=8.2",
        "doctrine/dbal": "^3.8|^4",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^3.2",
        "symfony/console": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/monolog-bundle": "^3.7",
        "symfony/twig-bundle": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/extra-bundle": "^3.12",
        "twig/twig": "^3.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/debug-bundle": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/maker-bundle": "^1.60",
        "symfony/phpunit-bridge": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": false
        }
    },
    "autoload": {
        "psr-4": {
            "PanKrok\\ShoperAppstoreBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PanKrok\\ShoperAppstoreBundle\\Tests\\": "tests/"
        }
    }
}
